# Copy this file to .env.local and fill in the values. Never commit .env.local.
# See README.md → Environment variables.

# Owner connection (local only: setup and db:check, never used by the site)
DATABASE_URL=

# Role connections (pooled, "-pooler" in the host)
DATABASE_URL_APP=
DATABASE_URL_CATALOG_READ=
DATABASE_URL_CATALOG_WRITE=

# Random strings: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
CRON_SECRET=

# Email (Brevo). Leave BREVO_API_KEY empty locally to print emails in the terminal.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Forkful

# Optional: base address for email links (defaults to the Vercel address or localhost)
APP_URL=

# Database tests: put these in .env.test.local, NOT here or in .env.local (see README → Testing).
# DATABASE_URL_TEST=
# DATABASE_URL_TEST_CATALOG_READ=
